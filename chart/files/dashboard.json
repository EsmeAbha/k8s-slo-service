{
  "title": "slo-service: SLOs",
  "uid": "slo-service",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "stat", "title": "Availability (30d) vs 99.5% SLO",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 3,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0.995 } ] } } },
      "targets": [ { "refId": "A", "expr": "1 - (sum(increase(slo_service_http_requests_total{status=~\"5..\"}[30d])) / clamp_min(sum(increase(slo_service_http_requests_total[30d])), 1e-9))" } ]
    },
    {
      "type": "stat", "title": "Error budget remaining (30d)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.25 }, { "color": "green", "value": 0.5 } ] } } },
      "targets": [ { "refId": "A", "expr": "1 - ((sum(increase(slo_service_http_requests_total{status=~\"5..\"}[30d])) / clamp_min(sum(increase(slo_service_http_requests_total[30d])), 1e-9)) / 0.005)" } ]
    },
    {
      "type": "stat", "title": "Burn rate (1h)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 6 }, { "color": "red", "value": 14.4 } ] } } },
      "targets": [ { "refId": "A", "expr": "slo:request_errors:ratio_rate1h / 0.005" } ]
    },
    {
      "type": "stat", "title": "p95 latency (5m)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s",
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.3 } ] } } },
      "targets": [ { "refId": "A", "expr": "slo:request_latency_seconds:p95_5m" } ]
    },
    {
      "type": "timeseries", "title": "Requests per second by status",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [ { "refId": "A", "expr": "sum by (status) (rate(slo_service_http_requests_total[1m]))", "legendFormat": "{{status}}" } ]
    },
    {
      "type": "timeseries", "title": "Error ratio (5m) vs fast-burn threshold",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        { "refId": "A", "expr": "slo:request_errors:ratio_rate5m", "legendFormat": "error ratio" },
        { "refId": "B", "expr": "vector(14.4 * 0.005)", "legendFormat": "fast-burn threshold" }
      ]
    },
    {
      "type": "timeseries", "title": "Latency percentiles",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(slo_service_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(slo_service_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(slo_service_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    }
  ]
}
